# Local development only. Generate actual local credentials using npm run env:init.
APP_ENV=local
COMPOSE_PROJECT_NAME=family-ai-onboarding
POSTGRES_USER=family_owner
POSTGRES_PASSWORD=replace-with-local-random-password
POSTGRES_DB=family_dev
POSTGRES_PORT=54339
DATABASE_URL=postgresql://family_owner:replace-with-local-random-password@127.0.0.1:54339/family_dev
AUTH_DATABASE_URL=postgresql://family_auth:replace-with-local-random-auth-password@127.0.0.1:54339/family_dev
RUNTIME_DATABASE_URL=postgresql://family_runtime:replace-with-local-random-runtime-password@127.0.0.1:54339/family_dev
BETTER_AUTH_SECRET=replace-with-local-random-secret
WEB_ORIGIN=http://127.0.0.1:3200
API_INTERNAL_URL=http://127.0.0.1:4010
HOST=127.0.0.1
API_PORT=4010
PORT=3200
WEB_PORT=3200
SMTP_HOST=127.0.0.1
SMTP_PORT=1035
MAILPIT_PORT=8035
MAIL_FROM=no-reply@family-ai.local
