{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json", "design/tokens.json"],
  "globalPassThroughEnv": [
    "APP_ENV",
    "AUTH_DATABASE_URL",
    "RUNTIME_DATABASE_URL",
    "WORKER_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "WEB_ORIGIN",
    "API_INTERNAL_URL",
    "API_PORT",
    "PORT",
    "HOST",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASSWORD",
    "MAIL_FROM",
    "MEDIA_STORAGE_ENDPOINT",
    "MEDIA_STORAGE_REGION",
    "MEDIA_STORAGE_BUCKET",
    "MEDIA_STORAGE_ACCESS_KEY_ID",
    "MEDIA_STORAGE_SECRET_ACCESS_KEY",
    "MEDIA_STORAGE_FORCE_PATH_STYLE"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["API_INTERNAL_URL"]
    },
    "@family/ui#build": { "outputs": [] },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_PORT", "PORT", "HOST", "API_INTERNAL_URL", "WEB_ORIGIN"]
    },
    "start": {
      "cache": false,
      "passThroughEnv": [
        "APP_ENV",
        "AUTH_DATABASE_URL",
        "RUNTIME_DATABASE_URL",
        "WORKER_DATABASE_URL",
        "BETTER_AUTH_SECRET",
        "WEB_ORIGIN",
        "API_INTERNAL_URL",
        "API_PORT",
        "PORT",
        "HOST",
        "SMTP_HOST",
        "SMTP_PORT",
        "SMTP_SECURE",
        "SMTP_USER",
        "SMTP_PASSWORD",
        "MAIL_FROM",
        "MEDIA_STORAGE_ENDPOINT",
        "MEDIA_STORAGE_REGION",
        "MEDIA_STORAGE_BUCKET",
        "MEDIA_STORAGE_ACCESS_KEY_ID",
        "MEDIA_STORAGE_SECRET_ACCESS_KEY",
        "MEDIA_STORAGE_FORCE_PATH_STYLE"
      ]
    }
  }
}
