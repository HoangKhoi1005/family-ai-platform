COMPOSE_PROJECT_NAME=family-ai-staging
IMAGE_REPOSITORY=family-ai
IMAGE_TAG=REPLACE_WITH_GIT_SHA

APP_ENV=staging
ALLOW_STAGING_PROVISION=false
POSTGRES_USER=family_owner
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_OWNER_PASSWORD
POSTGRES_DB=family_stage
DATABASE_URL=postgresql://family_owner:REPLACE_WITH_URL_ENCODED_OWNER_PASSWORD@postgres:5432/family_stage
AUTH_DATABASE_URL=postgresql://family_auth:REPLACE_WITH_URL_ENCODED_AUTH_PASSWORD@postgres:5432/family_stage
RUNTIME_DATABASE_URL=postgresql://family_runtime:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/family_stage
WORKER_DATABASE_URL=postgresql://family_worker:REPLACE_WITH_URL_ENCODED_WORKER_PASSWORD@postgres:5432/family_stage

BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_64_CHARACTER_SECRET
WEB_ORIGIN=https://REPLACE_WITH_TS_NET_HOST
API_INTERNAL_URL=http://api:4010
HOST=0.0.0.0
API_PORT=4010
PORT=3200

SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=resend
SMTP_PASSWORD=REPLACE_WITH_RESEND_SMTP_KEY
MAIL_FROM=no-reply@REPLACE_WITH_VERIFIED_DOMAIN

MEDIA_STORAGE_ENDPOINT=https://REPLACE_WITH_R2_ACCOUNT_ID.r2.cloudflarestorage.com
MEDIA_STORAGE_REGION=auto
MEDIA_STORAGE_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
MEDIA_STORAGE_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
MEDIA_STORAGE_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
MEDIA_STORAGE_FORCE_PATH_STYLE=false
R2_BUCKET_PUBLIC_ACCESS=false
